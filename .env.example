# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy as .env.local and configure for your environment

# ============================================
# NODE ENVIRONMENT
# ============================================
NODE_ENV=development
PORT=3001

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db

# Database connection pool (optional)
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# CACHE (Redis)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT
# ============================================
# Generate: openssl rand -base64 32
JWT_SECRET=your-secret-key-change-in-production-16+chars
JWT_EXPIRY_SECONDS=900  # 15 minutes

# ============================================
# CORS
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,https://app.example.com

# ============================================
# EMAIL PROVIDER (Optional)
# ============================================
# Currently unused, for future email verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@example.com

# ============================================
# SMS PROVIDER (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# OAUTH: GOOGLE
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/google/callback

# ============================================
# OAUTH: APPLE
# ============================================
APPLE_CLIENT_ID=com.your-company.your-app
APPLE_TEAM_ID=ABCDEFG123
APPLE_KEY_ID=ABC123
APPLE_KEY_FILE_PATH=./private_keys/AuthKey_ABC123.p8
APPLE_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/apple/callback

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug  # debug, info, warn, error
LOG_FORMAT=json # json, text
LOG_FILE_PATH=./logs

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
DATADOG_API_KEY=your-datadog-api-key

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# SESSION
# ============================================
SESSION_EXPIRY_DAYS=7
SESSION_INACTIVE_TIMEOUT_DAYS=30

# ============================================
# PASSWORD REQUIREMENTS
# ============================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=true

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_EXPIRY_SECONDS=300  # 5 minutes
OTP_MAX_ATTEMPTS=3
OTP_MAX_REQUESTS_PER_WINDOW=3

# ============================================
# WEBHOOK (Future)
# ============================================
WEBHOOK_ENABLED=false
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_RETRY_ATTEMPTS=3

# ============================================
# DEPLOYMENT
# ============================================
# AWS (if using AWS infrastructure)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3 bucket for logs/archives
AWS_S3_BUCKET=auth-service-logs
AWS_S3_REGION=us-east-1

# RDS Database (if using RDS instead of self-managed)
# RDS_ENDPOINT=auth-db.xxx.us-east-1.rds.amazonaws.com

# ElastiCache (if using instead of self-managed Redis)
# ELASTICACHE_ENDPOINT=auth-cache.xxx.ng.0001.use1.cache.amazonaws.com
